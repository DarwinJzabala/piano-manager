{
  "name": "piano-class-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gestor de clases de piano sobre Cloudflare Pages + D1",
  "scripts": {
    "test": "node tests/run.mjs",
    "dev": "wrangler pages dev ./public --ip 127.0.0.1 --binding LOCAL_DEV=1",
    "deploy": "wrangler pages deploy ./public",
    "db:init": "wrangler d1 execute piano-manager-db --local --file=./schema.sql",
    "db:migrate": "wrangler d1 execute piano-manager-db --local --file=./migrations/001_income.sql",
    "db:init:remote": "wrangler d1 execute piano-manager-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true
  },
  "dependencies": {
    "jose": "^6.2.17"
  }
}
